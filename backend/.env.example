# =============================================================================
# Autonomous AI System — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control (it's in .gitignore).

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="Autonomous AI System"
VERSION="1.0.0"
DEBUG=true

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose ONE: openai | groq | ollama
# Groq is free and fast — great for development
# Get Groq key at: https://console.groq.com (free)
# Get OpenAI key at: https://platform.openai.com/api-keys
LLM_PROVIDER=groq

GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# OLLAMA_BASE_URL=http://localhost:11434

# ── LLM Models ───────────────────────────────────────────────────────────────
GROQ_MODEL=llama3-70b-8192
OPENAI_MODEL=gpt-4o
OLLAMA_MODEL=mistral

# ── Embeddings ───────────────────────────────────────────────────────────────
# huggingface = free, local (downloads ~80MB model on first run)
# openai = better quality, requires OPENAI_API_KEY
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ── Vector Database ──────────────────────────────────────────────────────────
VECTOR_DB=faiss
FAISS_INDEX_PATH=./data/faiss_index

# Pinecone (production only — comment out if using FAISS)
# VECTOR_DB=pinecone
# PINECONE_API_KEY=your_pinecone_key_here
# PINECONE_ENV=us-east-1-aws
# PINECONE_INDEX=autonomous-ai

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (development — zero setup)
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# PostgreSQL (production — uncomment and fill in)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/autonomous_ai

# ── File Upload ───────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=50

# ── RAG Parameters ────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=5

# ── CORS ──────────────────────────────────────────────────────────────────────
# Add your frontend URL here
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
